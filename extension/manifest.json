{
  "manifest_version": 3,
  "name": "PlugPass",
  "version": "0.3.0",
  "description": "Use a PlugPass USB drive as a security key in Chrome and Edge.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://accounts.google.com/*",
        "https://myaccount.google.com/*",
        "https://webauthn.io/*"
      ],
      "js": ["src/inject.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://accounts.google.com/*",
        "https://myaccount.google.com/*",
        "https://webauthn.io/*"
      ],
      "js": ["src/codec.js", "src/bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
