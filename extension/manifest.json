{
  "manifest_version": 3,
  "name": "PlugPass",
  "version": "0.1.0",
  "description": "Use a PlugPass USB drive as a security key in Chrome and Edge.",
  "minimum_chrome_version": "120",
  "permissions": ["nativeMessaging"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  }
}
